# Each role can use its own provider. provider = openai | claude-cli | mock
# "openai" means any OpenAI-compatible endpoint (EdgeOne Makers gateway, DeepSeek, OpenAI, OpenRouter...).
VICTIM_PROVIDER=claude-cli
VICTIM_MODEL=haiku
ATTACKER_PROVIDER=claude-cli
ATTACKER_MODEL=haiku
JUDGE_PROVIDER=claude-cli
JUDGE_MODEL=sonnet
# Independent judge from a different model family via the EdgeOne Makers model gateway (OpenAI-compatible).
# Get the key in the Makers console: Models > Keys. Then uncomment these four lines and delete the two JUDGE_ lines above.
# JUDGE_PROVIDER=openai
# JUDGE_BASE_URL=https://ai-gateway.edgeone.link/v1
# JUDGE_API_KEY=your-key-here
# JUDGE_MODEL=@makers/deepseek-v4-pro
CONCURRENCY=7
